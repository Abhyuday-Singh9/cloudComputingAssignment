# Example Secret file - do NOT commit real credentials
# Copy to k8s/secret.yaml (ignored by git) and apply with kubectl
apiVersion: v1
kind: Secret
metadata:
  name: s3-credentials
  namespace: data
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: cloudadmin
  AWS_SECRET_ACCESS_KEY: cloudsecret123
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-credentials
  namespace: pipeline
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: cloudadmin
  AWS_SECRET_ACCESS_KEY: cloudsecret123
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-credentials
  namespace: app
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: cloudadmin
  AWS_SECRET_ACCESS_KEY: cloudsecret123
